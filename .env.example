# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# Токен DaData для подсказок адреса при оформлении заказа: dadata.ru → профиль → API-ключи.
# Без него поле адреса работает как обычное текстовое.
DADATA_API_KEY=

# Путь к файлу SQLite. По умолчанию — .data/sensory-book-club.db в корне проекта.
# DATABASE_PATH=/var/lib/sensory-book-club/app.db
